    {
      "name": "1. Iniciar sesión",
      "item": [
        {
          "name": "Iniciar sesión (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"contrasena\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const datos = pm.response.json();",
                  "pm.test(\"Entrega token y no la contraseña\", function () { pm.expect(datos.token).to.be.a(\"string\"); pm.expect(datos).to.not.have.property(\"contrasena\"); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", datos.token);",
                  "pm.collectionVariables.set(\"adminId\", datos.id);"
                ]
              }
            }
          ]
        },
