    {
      "name": "4. Auxiliar: venta en mostrador y anulación",
      "item": [
        {
          "name": "Elegir un producto sin receta con stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const producto = pm.response.json().find(p => !p.requiere_receta && (p.stock || 0) > 0 && p.activo !== false && p.estado === \"Activo\");",
                  "pm.test(\"Hay un producto disponible para la prueba\", function () { pm.expect(producto).to.be.an(\"object\"); });",
                  "if (producto) { pm.collectionVariables.set(\"productoId\", producto.id); pm.collectionVariables.set(\"stockAntes\", producto.stock); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar venta en mostrador (queda Pendiente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": {{clienteId}},\n  \"items\": [\n    {\n      \"producto_id\": {{productoId}},\n      \"cantidad\": 1\n    }\n  ],\n  \"metodo_entrega\": \"Recojo en tienda\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const datos = pm.response.json();",
                  "pm.test(\"La venta queda Pendiente hasta cobrarla\", function () { pm.expect(datos.pedido.estado).to.eql(\"Pendiente\"); });",
                  "pm.collectionVariables.set(\"pedidoId\", datos.pedido.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Anular la venta sin cobrar (devuelve el stock)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/anular",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedidoId}}",
                "anular"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Queda Cancelado\", function () { pm.expect(pm.response.json().estado).to.eql(\"Cancelado\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprobar que el stock volvió",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El stock es el mismo de antes\", function () { pm.expect(pm.response.json().stock).to.eql(Number(pm.collectionVariables.get(\"stockAntes\"))); });"
                ]
              }
            }
